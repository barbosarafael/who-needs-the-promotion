{
  "$schema": "https://opencode.ai/tui.json",

  "theme": "tokyonight",
  "leader_timeout": 2000,

  "keybinds": {
    "leader": "ctrl+x",
    "command_list": "ctrl+p"
  },

  "scroll_speed": 3,
  "diff_style": "stacked",

  "cursor": {
    "style": "block",
    "blinking": true
  },

  "mouse": true,

  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true,
    "volume": 0.2
  }
}